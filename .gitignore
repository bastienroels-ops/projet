__pycache__/
*.py[cod]
.venv/
venv/
.env

# Fichiers de travail et rendus : jamais versionnés
work/
output/
# Les musiques de fond engendrées par outils/engendrer_musiques.py sont
# suivies : elles font partie du produit, et sans elles le menu « Musique »
# ne propose rien. Tout autre fichier déposé là reste ignoré — une musique
# trouvée ailleurs engage celui qui publie la vidéo, elle n'a rien à faire
# dans le dépôt.
assets/music/*
!assets/music/.gitkeep
!assets/music/Braises.mp3
!assets/music/Clair.mp3
!assets/music/Nocturne.mp3
!assets/music/Pulsation.mp3
!assets/music/Ressort.mp3

# Les rendus et la base des comptes d'une session Colab, écrits à côté du
# dépôt quand le carnet tourne hors de /content.
flambee-data/

# Le binaire du tunnel, téléchargé au premier lancement Colab (38 Mo).
# Il se retélécharge tout seul : le versionner alourdirait chaque clone.
colab/cloudflared

# Même règle pour les fonds d'écran scindé : les trois boucles engendrées par
# outils/engendrer_fonds.py sont suivies, tout le reste est ignoré. Une
# capture de jeu déposée là t'appartient peut-être, mais son éditeur peut la
# faire retirer — et avec elle la vidéo qui la contient. Elle n'a rien à
# faire dans le dépôt.
assets/fonds/*
!assets/fonds/.gitkeep
!assets/fonds/Damier.mp4
!assets/fonds/Remous.mp4
!assets/fonds/Vagues.mp4
