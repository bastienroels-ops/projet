# Copie ce fichier en .env et renseigne les valeurs.

# Le nom de domaine qui pointe vers le serveur (obligatoire pour le HTTPS).
DOMAINE=flambee.exemple.fr

# Clé de signature des sessions. À engendrer une fois, puis à ne plus changer :
# la modifier déconnecte tout le monde.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLAMBEE_SECRET_KEY=

# Inscriptions : « ouvert » ou « ferme ».
FLAMBEE_SIGNUP=ouvert
# Si renseigné, ce code est exigé à l'inscription.
FLAMBEE_INVITE_CODE=

# Génération de script en un clic (facultatif).
ANTHROPIC_API_KEY=

# Modèle de transcription : tiny, base, small, medium.
# « base » tient le bon compromis entre vitesse et exactitude.
FLAMBEE_WHISPER_MODEL=base

# Priorité de l'encodage : au-dessus de 0, ffmpeg laisse respirer le réseau.
FLAMBEE_NICE=5

# Taille maximale d'une vidéo importée, en mégaoctets.
FLAMBEE_MAX_UPLOAD_MB=600
