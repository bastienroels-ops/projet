# Copie ce fichier en .env et renseigne les valeurs.

# Le nom de domaine qui pointe vers le serveur (obligatoire pour le HTTPS).
DOMAINE=flambee.exemple.fr

# Clé de signature des sessions. À engendrer une fois, puis à ne plus changer :
# la modifier déconnecte tout le monde.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLAMBEE_SECRET_KEY=

# Inscriptions : « ouvert » ou « ferme ».
FLAMBEE_SIGNUP=ouvert
# Si renseigné, ce code est exigé à l'inscription.
FLAMBEE_INVITE_CODE=

# Formule du premier compte créé — celui de l'administrateur. « studio » lui
# donne des crédits illimités et toutes les rubriques ; mets « essai » pour
# qu'il soit un compte comme les autres.
FLAMBEE_PLAN_PROPRIETAIRE=studio

# Génération de script en un clic (facultatif).
ANTHROPIC_API_KEY=

# Modèle de transcription : tiny, base, small, medium.
# « base » tient le bon compromis entre vitesse et exactitude.
FLAMBEE_WHISPER_MODEL=base

# Bouton d'installation du moteur de transcription depuis l'interface,
# réservé au compte administrateur. Mets 0 pour le retirer.
FLAMBEE_INSTALL_MOTEUR=1

# Priorité de l'encodage : au-dessus de 0, ffmpeg laisse respirer le réseau.
FLAMBEE_NICE=5

# Taille maximale d'une vidéo importée, en mégaoctets.
FLAMBEE_MAX_UPLOAD_MB=600

# Envoi des courriels (réinitialisation de mot de passe). Facultatif :
# sans ces variables, le lien est écrit dans le journal du serveur
# (docker compose logs flambee) et la page le dit à l'utilisateur.
FLAMBEE_SMTP_HOTE=
FLAMBEE_SMTP_PORT=587
FLAMBEE_SMTP_UTILISATEUR=
FLAMBEE_SMTP_MOT_DE_PASSE=
# Adresse d'expédition, si elle diffère de l'identifiant SMTP.
FLAMBEE_SMTP_EXPEDITEUR=
